{
  "name": "living-design-scaffold",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:html": "tsc -b && vite build --config vite.singlefile.config.ts",
    "preview": "vite preview",
    "postinstall": "playwright install chromium || true",
    "ld": "node scripts/ld/cli.mjs",
    "ld:context": "node scripts/ld/cli.mjs context",
    "ld:search": "node scripts/ld/cli.mjs search",
    "ld:utils": "node scripts/ld/cli.mjs utils",
    "ld:menu": "node scripts/ld/cli.mjs menu",
    "ld:doctor": "node scripts/ld/cli.mjs doctor",
    "ld:hook": "node scripts/ld/hook.mjs",
    "a11y:endhook": "node scripts/a11y/run-endhook.mjs",
    "a11y:scan": "node scripts/a11y/scan.mjs"
  },
  "dependencies": {
    "@lottiefiles/dotlottie-react": "^0.19.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-resizable-panels": "^4.11.1",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "axe-core": "^4.12.1",
    "playwright": "^1.58.2",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.3.3"
  }
